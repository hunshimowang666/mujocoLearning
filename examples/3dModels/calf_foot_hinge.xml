<mujoco model="calf_foot_hinge">
    <compiler angle="degree" autolimits="true"/>
    <option gravity="0 0 -10" timestep="0.002"/>

    <asset>
        <!-- SolidWorks 导出的 STL 使用 mm，这里统一缩放到 MuJoCo 的 m -->
        <mesh name="calf_mesh" file="calf.STL" scale="0.001 0.001 0.001"/>
        <mesh name="foot_mesh" file="foot.STL" scale="0.001 0.001 0.001"/>
    </asset>

    <worldbody>
        <light diffuse=".5 .5 .5" pos="0 0 3" dir="0 0 -1"/>
        <geom type="plane" size="5 5 0.1" rgba=".9 .9 .9 1"/>

        <!-- calf 的 STL 长轴是 SolidWorks 的 X 轴；这里把 calf 局部 +X 方向转到竖直向下 -->
        <body name="calf" pos="0 0 0.155" euler="0 90 0">
            <freejoint/>
            <geom name="calf_geom" type="mesh" mesh="calf_mesh" rgba="0.8 0.2 0.15 1" mass="1"/>

            <!--
                foot body 原点放在 calf 局部坐标 x=150mm 处。
                hinge joint 的 pos="0 0 0" 表示关节轴经过 foot body 原点；
                当前 foot mesh 未设置 pos，因此 foot.STL 的原始 (0,0,0) 对齐在这个点。
            -->
            <body name="foot" pos="0.15 0 0" euler="0 0 90">
                <joint name="ankle_hinge" type="hinge" pos="0 0 0" axis="0 0 1" damping="0.05"/>
                <!-- 当前装配姿态下，foot 局部 Z 轴对应小腿前后摆动的踝关节轴 -->
                <geom name="foot_geom" type="mesh" mesh="foot_mesh" rgba="0.15 0.35 0.9 1" mass="0.5"/>

                <site name="hinge_origin" pos="0 0 0" type="sphere" size="0.015" rgba="0 1 0 1"/>
            </body>
        </body>
    </worldbody>
</mujoco>
